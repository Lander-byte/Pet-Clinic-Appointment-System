package ui.screens.admin;

import ui.components.Logo;
import ui.components.UiTheme;
import ui.components.RoundedPanel;

import javax.swing.JButton;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.SwingConstants;
import java.awt.Color;
import java.awt.Dimension;
import java.awt.Font;
import java.awt.GradientPaint;
import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.RenderingHints;

public class LandingScreen extends JPanel {
    private static final int PANEL_WIDTH = 940;
    private static final int PANEL_HEIGHT = 670;

    public LandingScreen(Runnable onLogin) {
        setLayout(null);
        setBackground(Color.WHITE);
        setPreferredSize(new Dimension(PANEL_WIDTH, PANEL_HEIGHT));

        // Background Decorative Elements
        JPanel glassCard = new RoundedPanel(new Color(255, 255, 255, 220), 40) {
            @Override
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(new Color(240, 240, 240, 100));
                g2.drawRoundRect(0, 0, getWidth()-1, getHeight()-1, 40, 40);
                g2.dispose();
            }
        };
        glassCard.setLayout(null);
        glassCard.setBounds(220, 100, 500, 450);
        add(glassCard);

        Logo logo = new Logo(92);
        logo.setBounds(15, 60, 470, 130);
        glassCard.add(logo);

        JLabel slogan = new JLabel("Compassionate care for your best friends.", SwingConstants.CENTER);
        slogan.setFont(UiTheme.BODY_FONT.deriveFont(Font.ITALIC, 16f));
        slogan.setForeground(UiTheme.TEXT_GRAY);
        slogan.setBounds(0, 190, 500, 30);
        glassCard.add(slogan);

        JButton loginBtn = UiTheme.pillButton("GET STARTED", UiTheme.BLUE, Color.WHITE, 14);
        loginBtn.setBounds(125, 280, 250, 50);
        loginBtn.addActionListener(e -> onLogin.run());
        glassCard.add(loginBtn);
        
        JLabel footer = new JLabel("Professional Veterinary Appointment System", SwingConstants.CENTER);
        footer.setFont(UiTheme.BODY_FONT.deriveFont(11f));
        footer.setForeground(new Color(180, 180, 180));
        footer.setBounds(0, 400, 500, 20);
        glassCard.add(footer);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        
        // Background Gradient
        GradientPaint gp = new GradientPaint(0, 0, new Color(245, 250, 255), 0, getHeight(), Color.WHITE);
        g2.setPaint(gp);
        g2.fillRect(0, 0, getWidth(), getHeight());
        
        // Abstract shapes for "Beauty"
        g2.setColor(new Color(0, 88, 128, 20));
        g2.fillOval(-100, -100, 400, 400);
        g2.fillOval(getWidth() - 300, getHeight() - 300, 500, 500);
        
        g2.dispose();
    }
}
